# Browser
BROWSER_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
GAME_URL=https://www.bubbleshooter.com/
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
CANVAS_TIMEOUT_MS=30000
BLOCK_ADS=true
USER_DATA_DIR=.brave-profile

# Pacing (how human the aiming looks)
AIM_SPEED_PX_S=700
AIM_MIN_S=0.25
AIM_MAX_S=1.0
SHOT_WAIT_S=1.2
# chance of 0, 1 or 2 extra "considered" angles before each shot
WAYPOINT_COUNT_WEIGHTS=0.3,0.5,0.2
# false = click the target directly, no sweeps, pauses or jitter (for test runs)
HUMAN_AIM=true
# true = after each shot wait until the board stops changing instead of sleeping SHOT_WAIT_S
ADAPTIVE_WAIT=false

# Strategy weights
DROP_WEIGHT=10.0
DEPTH_WEIGHT=0.15
MISS_BASE=-3.0
FRIEND_WEIGHT=0.4
GROWTH_PENALTY=1.5
# when the lowest bubble reaches PRESSURE_ROW, shots that raise the front line get FRONT_WEIGHT per row
PRESSURE_ROW=8
FRONT_WEIGHT=4.0

# Run limits (0 = unlimited) and output
MAX_PLAY_MINUTES=0
MAX_SHOTS=0
SCREENSHOT_DIR=screens
