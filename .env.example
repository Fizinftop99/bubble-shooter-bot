# Browser
BROWSER_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
GAME_URL=https://www.bubbleshooter.com/
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
CANVAS_TIMEOUT_MS=30000
BLOCK_ADS=true
USER_DATA_DIR=.brave-profile
# keep the browser window open after the game ends until you close it
KEEP_OPEN=true
# true = no window. If BROWSER_PATH does not exist, the Chromium installed by Playwright is used (cloud runs)
HEADLESS=false

# Pacing (how human the aiming looks)
AIM_SPEED_PX_S=700
AIM_MIN_S=0.25
AIM_MAX_S=1.0
SHOT_WAIT_S=1.2
# chance of 0, 1 or 2 extra "considered" angles before each shot
WAYPOINT_COUNT_WEIGHTS=0.3,0.5,0.2
# false = click the target directly, no sweeps, pauses or jitter (for test runs)
HUMAN_AIM=true
# true = after each shot wait until the board stops changing instead of sleeping SHOT_WAIT_S
ADAPTIVE_WAIT=false

# Strategy weights
DROP_WEIGHT=10.0
DEPTH_WEIGHT=0.15
MISS_BASE=-3.0
FRIEND_WEIGHT=0.4
GROWTH_PENALTY=1.5
# when the lowest bubble reaches PRESSURE_ROW, shots that raise the front line get FRONT_WEIGHT per row
PRESSURE_ROW=8
FRONT_WEIGHT=4.0
# each colour wiped off the board adds a row to every later push; ignored when <= WIPE_FREE_BUBBLES bubbles remain
COLOR_WIPE_PENALTY=30.0
WIPE_FREE_BUBBLES=15

# Decider: who picks each shot. rule = built-in strategy, model = local LLM (falls back to the rule on any failure)
DECIDER=rule
# model identifier as shown by `lms ls`, and the OpenAI-compatible server address (LM Studio default)
# use 127.0.0.1, not localhost: on Windows the name lookup adds about 2 s to every request
MODEL_NAME=qwen3-4b-instruct-2507
MODEL_URL=http://127.0.0.1:1234/v1
# per-shot deadline for the model answer; after it the rule's shot is used
MODEL_TIMEOUT_S=3.0
# how long the first request may take while the model loads into memory
MODEL_WARMUP_S=120
# one JSON line per decision is written here when DECIDER=model (empty = no log)
DECISION_LOG_DIR=logs

# Run limits (0 = unlimited) and output
MAX_PLAY_MINUTES=0
MAX_SHOTS=0
SCREENSHOT_DIR=screens
